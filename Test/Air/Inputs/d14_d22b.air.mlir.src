module {
  // D14: a pattern on a view at a nonzero position starts at the view's element 0 (%m[1, 0],
  // element 8) and counts in elements of the buffer: [2] [4] [1] reads elements 10 to 13. The
  // store to %m[1, 3] (element 11) races with it; the one to %m[1, 7] (element 15) does not.
  func.func @pattern_on_view() {
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %c7 = arith.constant 7 : index
    %z = arith.constant 5 : i16
    %m = memref.alloc() : memref<4x8xi16>
    %d = memref.alloc() : memref<4xi16>
    %t, %sv = air.execute -> (memref<8xi16, strided<[1], offset: 8>>) {
      %v = memref.subview %m[1, 0] [1, 8] [1, 1] : memref<4x8xi16> to memref<8xi16, strided<[1], offset: 8>>
      air.execute_terminator %v : memref<8xi16, strided<[1], offset: 8>>
    }
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %x = air.dma_memcpy_nd async [%t] (%d[] [] [], %sv[%c2] [%c4] [%c1]) : (memref<4xi16>, memref<8xi16, strided<[1], offset: 8>>)
    %u = air.execute {
      memref.store %z, %m[%c1, %c3] : memref<4x8xi16>
    }
    %w = air.execute {
      memref.store %z, %m[%c1, %c7] : memref<4x8xi16>
    }
    air.wait_all [%x, %u, %w]
    return
  }

  // D22b: two fills of disjoint subviews, not ordered: they touch only their views' elements, so
  // they do not race.
  func.func @fills_disjoint() {
    %z = arith.constant 0 : i32
    %m = memref.alloc() : memref<4x8xi32>
    %a = air.execute {
      %v = memref.subview %m[0, 0] [2, 8] [1, 1] : memref<4x8xi32> to memref<2x8xi32, strided<[8, 1]>>
      linalg.fill ins(%z : i32) outs(%v : memref<2x8xi32, strided<[8, 1]>>)
    }
    %b = air.execute {
      %v = memref.subview %m[2, 0] [2, 8] [1, 1] : memref<4x8xi32> to memref<2x8xi32, strided<[8, 1], offset: 16>>
      linalg.fill ins(%z : i32) outs(%v : memref<2x8xi32, strided<[8, 1], offset: 16>>)
    }
    air.wait_all [%a, %b]
    return
  }

  // D22b: the same fills, overlapping in row 1: a race on its first element, 8.
  func.func @fills_overlap() {
    %z = arith.constant 0 : i32
    %m = memref.alloc() : memref<4x8xi32>
    %a = air.execute {
      %v = memref.subview %m[0, 0] [2, 8] [1, 1] : memref<4x8xi32> to memref<2x8xi32, strided<[8, 1]>>
      linalg.fill ins(%z : i32) outs(%v : memref<2x8xi32, strided<[8, 1]>>)
    }
    %b = air.execute {
      %v = memref.subview %m[1, 0] [2, 8] [1, 1] : memref<4x8xi32> to memref<2x8xi32, strided<[8, 1], offset: 8>>
      linalg.fill ins(%z : i32) outs(%v : memref<2x8xi32, strided<[8, 1], offset: 8>>)
    }
    air.wait_all [%a, %b]
    return
  }
}
