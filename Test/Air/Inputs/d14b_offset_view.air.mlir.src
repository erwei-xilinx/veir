module {
  // A pattern on a view at offset 4 (D14): from the view's element 0, position 4 of %src, in
  // elements of %src: positions 4 and 6.
  func.func @offset_view(%src: memref<16xi32>, %out: memref<2xi32>) {
    %c1 = arith.constant 1 : index
    air.launch (%l) in (%ls=%c1) args(%a=%src, %o=%out) : memref<16xi32>, memref<2xi32> {
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %u = arith.constant 1 : index
      %v = memref.subview %a[4] [8] [1] : memref<16xi32> to memref<8xi32, strided<[1], offset: 4>>
      air.dma_memcpy_nd (%o[] [] [], %v[%c0] [%c2] [%c2]) : (memref<2xi32>, memref<8xi32, strided<[1], offset: 4>>)
    }
    return
  }
}
