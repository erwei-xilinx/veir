module {
  air.channel @C [1, 1]
  // D56: each air.launch instance has its own streams. Both instances put and get @C[0, 0];
  // each get receives its own instance's put.
  func.func @per_instance(%in: memref<8xi32>, %out: memref<8xi32>) {
    %c2 = arith.constant 2 : index
    air.launch (%i) in (%si=%c2) args(%a=%in, %o=%out) : memref<8xi32>, memref<8xi32> {
      %k0 = arith.constant 0 : index
      %k1 = arith.constant 1 : index
      %k4 = arith.constant 4 : index
      %off = arith.muli %i, %k4 : index
      %p = air.channel.put async @C[%k0, %k0] (%a[%off] [%k4] [%k1]) : (memref<8xi32>)
      air.segment @seg args(%so=%o, %soff=%off) : memref<8xi32>, index {
        %s1 = arith.constant 1 : index
        air.herd @h tile (%x, %y) in (%sx=%s1, %sy=%s1) args(%ho=%so, %hoff=%soff) : memref<8xi32>, index {
          %z = arith.constant 0 : index
          %u = arith.constant 1 : index
          %f = arith.constant 4 : index
          %buf = memref.alloc() : memref<4xi32, 2>
          air.channel.get @C[%z, %z] (%buf[] [] []) : (memref<4xi32, 2>)
          air.dma_memcpy_nd (%ho[%hoff] [%f] [%u], %buf[] [] []) : (memref<8xi32>, memref<4xi32, 2>)
          memref.dealloc %buf : memref<4xi32, 2>
        }
      }
    }
    return
  }
}
