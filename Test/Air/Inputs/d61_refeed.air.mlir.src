module {
  air.channel @c3 [1, 1]
  air.channel @c2 [1, 1] {air.refeed_count = 2 : i32}
  air.channel @in [1, 1]
  air.channel @mid [1, 1]
  air.channel @g [1, 1]
  // D61 (a): air.refeed_count = 3 on an async put: three sends of src, in order; one get of 12
  // elements receives all three.
  func.func @op_count(%src: memref<4xi32>, %out: memref<12xi32>) {
    %c1 = arith.constant 1 : index
    air.launch (%l) in (%ls=%c1) args(%a=%src, %o=%out) : memref<4xi32>, memref<12xi32> {
      %c0 = arith.constant 0 : index
      %p = air.channel.put async @c3[%c0, %c0] (%a[] [] []) {air.refeed_count = 3 : i32} : (memref<4xi32>)
      air.segment @seg args(%so=%o) : memref<12xi32> {
        %s1 = arith.constant 1 : index
        air.herd @h tile (%x, %y) in (%sx=%s1, %sy=%s1) args(%oo=%so) : memref<12xi32> {
          %buf = memref.alloc() : memref<12xi32, 2 : i32>
          air.channel.get @c3[%x, %y] (%buf[] [] []) : (memref<12xi32, 2 : i32>)
          air.dma_memcpy_nd (%oo[] [] [], %buf[] [] []) : (memref<12xi32>, memref<12xi32, 2 : i32>)
          memref.dealloc %buf : memref<12xi32, 2 : i32>
        }
      }
      %w = air.wait_all async [%p]
    }
    return
  }
  // D61 (b): the count on the channel declaration applies to a put without its own; a sync put
  // stays sync (two buffered sends).
  func.func @decl_count(%src: memref<4xi32>, %out: memref<8xi32>) {
    %c1 = arith.constant 1 : index
    air.launch (%l) in (%ls=%c1) args(%a=%src, %o=%out) : memref<4xi32>, memref<8xi32> {
      %c0 = arith.constant 0 : index
      air.channel.put @c2[%c0, %c0] (%a[] [] []) : (memref<4xi32>)
      air.segment @seg args(%so=%o) : memref<8xi32> {
        %s1 = arith.constant 1 : index
        air.herd @h tile (%x, %y) in (%sx=%s1, %sy=%s1) args(%oo=%so) : memref<8xi32> {
          %buf = memref.alloc() : memref<8xi32, 2 : i32>
          air.channel.get @c2[%x, %y] (%buf[] [] []) : (memref<8xi32, 2 : i32>)
          air.dma_memcpy_nd (%oo[] [] [], %buf[] [] []) : (memref<8xi32>, memref<8xi32, 2 : i32>)
          memref.dealloc %buf : memref<8xi32, 2 : i32>
        }
      }
    }
    return
  }
  // D61 (c): an L2 producer: the count sits on the memref.alloc of the buffer the put sends.
  func.func @alloc_count(%src: memref<4xi32>, %out: memref<8xi32>) {
    %c1 = arith.constant 1 : index
    air.launch (%l) in (%ls=%c1) args(%a=%src, %o=%out) : memref<4xi32>, memref<8xi32> {
      %c0 = arith.constant 0 : index
      air.channel.put @in[%c0, %c0] (%a[] [] []) : (memref<4xi32>)
      air.segment @seg args(%so=%o) : memref<8xi32> {
        %s0 = arith.constant 0 : index
        %s1 = arith.constant 1 : index
        %l2 = memref.alloc() {air.refeed_count = 2 : i32} : memref<4xi32, 1 : i32>
        air.channel.get @in[%s0, %s0] (%l2[] [] []) : (memref<4xi32, 1 : i32>)
        air.channel.put @mid[%s0, %s0] (%l2[] [] []) : (memref<4xi32, 1 : i32>)
        air.herd @h tile (%x, %y) in (%sx=%s1, %sy=%s1) args(%oo=%so) : memref<8xi32> {
          %buf = memref.alloc() : memref<8xi32, 2 : i32>
          air.channel.get @mid[%x, %y] (%buf[] [] []) : (memref<8xi32, 2 : i32>)
          air.dma_memcpy_nd (%oo[] [] [], %buf[] [] []) : (memref<8xi32>, memref<8xi32, 2 : i32>)
          memref.dealloc %buf : memref<8xi32, 2 : i32>
        }
        memref.dealloc %l2 : memref<4xi32, 1 : i32>
      }
    }
    return
  }
  // D61 (d): a count on a get changes nothing: one receive.
  func.func @get_count(%src: memref<4xi32>, %out: memref<4xi32>) {
    %c1 = arith.constant 1 : index
    air.launch (%l) in (%ls=%c1) args(%a=%src, %o=%out) : memref<4xi32>, memref<4xi32> {
      %c0 = arith.constant 0 : index
      air.channel.put @g[%c0, %c0] (%a[] [] []) : (memref<4xi32>)
      air.segment @seg args(%so=%o) : memref<4xi32> {
        %s1 = arith.constant 1 : index
        air.herd @h tile (%x, %y) in (%sx=%s1, %sy=%s1) args(%oo=%so) : memref<4xi32> {
          %buf = memref.alloc() : memref<4xi32, 2 : i32>
          air.channel.get @g[%x, %y] (%buf[] [] []) {air.refeed_count = 5 : i32} : (memref<4xi32, 2 : i32>)
          air.dma_memcpy_nd (%oo[] [] [], %buf[] [] []) : (memref<4xi32>, memref<4xi32, 2 : i32>)
          memref.dealloc %buf : memref<4xi32, 2 : i32>
        }
      }
    }
    return
  }
}
