module {
  // scf.forall over (lb 0 and %n = 1) to (2, 8) step (1, 4): points (0,1), (0,5), (1,1), (1,5); each
  // writes 100 + its element's position there. After the loop the host reads them all: ordered after every iteration.
  func.func @forall_disjoint(%out: memref<16xi32>, %sum: memref<1xi32>) {
    %n = arith.constant 1 : index
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index
    scf.forall (%x, %y) = (0, %n) to (2, 8) step (1, 4) {
      %p = arith.muli %x, %c8 : index
      %q = arith.addi %p, %y : index
      %h = arith.constant 100 : index
      %w = arith.addi %q, %h : index
      %v = arith.index_cast %w : index to i32
      memref.store %v, %out[%q] : memref<16xi32>
    }
    %a = memref.load %out[%c0] : memref<16xi32>
    %b = memref.load %out[%n] : memref<16xi32>
    %s = arith.addi %a, %b : i32
    memref.store %s, %sum[%c0] : memref<1xi32>
    return
  }
  // affine.parallel: dimension 1 runs from max(0, 3 - 2) = 1 to min(8, 3 + 2) = 5 step 2: 1, 3.
  func.func @affine_groups(%out: memref<4x8xi32>) {
    %n = arith.constant 3 : index
    affine.parallel (%a, %b) = (0, max(0, %n - 2)) to (2, min(8, %n + 2)) step (1, 2) {
      %h = arith.constant 100 : index
      %w = arith.addi %b, %h : index
      %v = arith.index_cast %w : index to i32
      affine.store %v, %out[%a, %b] : memref<4x8xi32>
    }
    return
  }
  // Two iterations write element 0: a race, whichever parallel loop it is (D27).
  func.func @forall_same(%out: memref<4xi32>) {
    %c0 = arith.constant 0 : index
    scf.forall (%i) in (2) {
      %v = arith.index_cast %i : index to i32
      memref.store %v, %out[%c0] : memref<4xi32>
    }
    return
  }
  func.func @affine_same(%out: memref<4xi32>) {
    %c0 = arith.constant 0 : index
    affine.parallel (%i) = (0) to (2) {
      %v = arith.index_cast %i : index to i32
      memref.store %v, %out[%c0] : memref<4xi32>
    }
    return
  }
  func.func @parallel_same(%out: memref<4xi32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    scf.parallel (%i) = (%c0) to (%c2) step (%c1) {
      %v = arith.index_cast %i : index to i32
      memref.store %v, %out[%c0] : memref<4xi32>
      scf.reduce
    }
    return
  }
}
