// air-dependency-canonicalize drops a needed edge (found by Test/Air/bounded/check.py --data).
// Expected: %t2's dependencies reduce to [%t1]. Observed with air-opt at mlir-air 9b81b5de0: [].
// %t2 then reads %v0 without any token path to %t0 (SEMANTICS.md D4).
//   air-opt %s -air-dependency-canonicalize
// Trigger: an air.execute whose body has two or more ops (%t1 here) loses every outgoing edge;
// see ~/air-issues/AIR-002-canonicalize-drops-needed-edge/ISSUE.md for the root cause.
func.func @f() {
  %t0, %v0 = air.execute -> (i32) {
    %c1 = arith.constant 1 : i32
    air.execute_terminator %c1 : i32
  }
  %t1, %v1 = air.execute [%t0] -> (i32) {
    %c10 = arith.constant 10 : i32
    %s = arith.addi %c10, %v0 : i32
    air.execute_terminator %s : i32
  }
  %t2, %v2 = air.execute [%t0, %t1] -> (i32) {
    %c100 = arith.constant 100 : i32
    %s2 = arith.addi %c100, %v0 : i32
    air.execute_terminator %s2 : i32
  }
  return
}
